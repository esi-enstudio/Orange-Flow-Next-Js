NGROK_AUTH_TOKEN=
STATIC_DOMAIN=

DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=
DB_NAME=

# excel_wa_sync.py ব্রাউজার দৃশ্যমান রাখতে চাইলে False, আর ব্যাকগ্রাউন্ডে চালাতে চাইলে True
HEADLESS_MODE=True

WEBHOOK_PORT=8080
START_NGROK=True
FORWARD_OTPS_TO=None

# জিএ লাইভ সিঙ্ক চালু করতে চাইলে True, বন্ধ রাখতে চাইলে False লিখুন
ENABLE_GA_SYNC=True

# SMTP Configuration for Password Reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=app_password
SMTP_FROM=youremail@gmail.com
APP_URL=http://localhost:3000

# ── Frontend (Next.js) public variables ──────────────────────────────────────
# `NEXT_PUBLIC_*` values are baked into the bundle by `next build`, so they must
# be present BEFORE the frontend is built (docker-compose passes them to the
# container; a plain runtime env change is not enough — rebuild/restart).
# Google Maps browser key. Restrict it in Google Cloud Console → Credentials →
# Application restrictions → Websites to every origin that serves the app,
# e.g. http://localhost:3000/*  https://your-domain.com/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: localhost-friendly key used only by `next dev`
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY_DEV=
# Optional: mirror of the key's referrer list; other origins skip Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_ALLOWED_ORIGINS=


# JWT Authentication (required, generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Timezone
TIME_ZONE=Asia/Dhaka

# ── Live Location device ingest (MacroDroid) ──────────────────────────────────
# Optional shared secret. Leave empty to let the mobile macro POST to
# /api/v1/location/update without a key (internal deployments only).
LOCATION_INGEST_API_KEY=

# WhatsApp Multi-Session Gateway (go-whatsapp-multi-session-rest-api)
# Generate secure keys with: python -c "import secrets; print(secrets.token_hex(32))"
WA_GATEWAY_URL=http://whatsapp-gateway:7001
WA_GATEWAY_ADMIN_KEY=changeme-admin-secret
WA_GATEWAY_JWT_KEY=changeme-jwt-secret-min-32-chars-long
WA_GATEWAY_ENABLED=true

# ── Subscription & Billing (manual / offline payments) ────────────────────────
# There is no payment gateway. Money is received offline (cash / bank /
# mobile banking) and recorded by an authorised admin with
# billing.cash_payment / billing.manage — the invoice and plan then update.
CASH_PAYMENTS_ENABLED=true
# Billing policy
BILLING_GRACE_DAYS=7
BILLING_RENEWAL_REMINDER_DAYS=5
BILLING_TAX_PERCENT=0
DEFAULT_SUBSCRIPTION_PLAN_SLUG=basic
# ---- Plan access policy (deny-by-default) ----
# A house with no subscription, or an expired one, is blocked for all its users
# (super admins always pass). Billing/pricing/profile stay reachable so the
# tenant can renew. Set to false ONLY for a staged rollout.
BILLING_REQUIRE_PLAN=true
# One-time safety net for the switch to fail-closed: houses that existed before
# plan enforcement get an explicit legacy-unlimited plan instead of a lockout.
BILLING_LEGACY_BACKFILL=true
BILLING_LEGACY_PLAN_SLUG=legacy-unlimited
# Plan auto-assigned when a house is created (empty = start unsubscribed).
BILLING_DEFAULT_PLAN_SLUG=
# Report-only pass of the legacy backfill (migration dry run): logs which houses
# would receive the legacy plan and which rows would be repaired, writes nothing.
BILLING_LEGACY_BACKFILL_DRY_RUN=false
# ---- Runtime environment & production safety ----
# development | staging | production. In production the app REFUSES TO START if
# BILLING_REQUIRE_PLAN=false or BILLING_ENABLED=false.
ENVIRONMENT=development
# ---- Multi-tenant isolation ----
# true (default): every non-super-admin user must belong to the house named in
# X-House-ID. Set false ONLY for a single-company deployment where admin /
# manager roles are deliberately platform-wide.
TENANT_STRICT_HOUSE_ISOLATION=true
