NGROK_AUTH_TOKEN=
STATIC_DOMAIN=

DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=
DB_NAME=

# excel_wa_sync.py ব্রাউজার দৃশ্যমান রাখতে চাইলে False, আর ব্যাকগ্রাউন্ডে চালাতে চাইলে True
HEADLESS_MODE=True

WEBHOOK_PORT=8080
START_NGROK=True
FORWARD_OTPS_TO=None

# জিএ লাইভ সিঙ্ক চালু করতে চাইলে True, বন্ধ রাখতে চাইলে False লিখুন
ENABLE_GA_SYNC=True

# SMTP Configuration for Password Reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=app_password
SMTP_FROM=youremail@gmail.com
APP_URL=http://localhost:3000

# JWT Authentication (required, generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Timezone
TIME_ZONE=Asia/Dhaka

# WhatsApp Multi-Session Gateway (go-whatsapp-multi-session-rest-api)
# Generate secure keys with: python -c "import secrets; print(secrets.token_hex(32))"
WA_GATEWAY_URL=http://whatsapp-gateway:7001
WA_GATEWAY_ADMIN_KEY=changeme-admin-secret
WA_GATEWAY_JWT_KEY=changeme-jwt-secret-min-32-chars-long
WA_GATEWAY_ENABLED=true

# ── Subscription & Billing (SSLCommerz gateway) ───────────────────────────────
# Implemented gateway provider (currently only "sslcommerz")
PAYMENT_GATEWAY=sslcommerz
# Get sandbox store id/password from https://sandbox.sslcommerz.com (Create Sandbox Account)
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
# true = sandbox, false = live (requires production store credentials)
SSLCOMMERZ_SANDBOX=true
# Sandbox base (default). Live base: https://securepay.sslcommerz.com
SSLCOMMERZ_API_BASE=https://sandbox.sslcommerz.com
# Public URLs (must be reachable from the internet for IPN; use ngrok/STATIC_DOMAIN in dev)
SSLCOMMERZ_IPN_URL=
SSLCOMMERZ_SUCCESS_URL=http://localhost:3000/billing?payment=success
SSLCOMMERZ_FAIL_URL=http://localhost:3000/billing?payment=failed
SSLCOMMERZ_CANCEL_URL=http://localhost:3000/billing?payment=cancelled
# Billing policy
BILLING_GRACE_DAYS=7
BILLING_RENEWAL_REMINDER_DAYS=5
BILLING_TAX_PERCENT=0
# When true, checkout creates an invoice without calling the real gateway (dev)
BILLING_INVOICE_DRY_RUN=false
DEFAULT_SUBSCRIPTION_PLAN_SLUG=basic
