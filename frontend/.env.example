# Copy to `.env.local` (git-ignored) and fill in the values.

# Use the same-origin Next.js API rewrite for local and proxied deployments.
# Direct backend URLs must be reachable from the user's browser and allow its origin.
NEXT_PUBLIC_API_URL=/api

# ── Google Maps JavaScript API ────────────────────────────────────────────────
# Browser key. It is shipped to the client, so it MUST be restricted in
# Google Cloud Console → APIs & Services → Credentials → (key) →
# Application restrictions → Websites. Add one entry per deployed origin:
#     https://app.example.com/*
#     http://localhost:3000/*          (only if local development needs Google)
#     http://127.0.0.1:3000/*
# Leave empty to hide the Google Maps provider (the app uses OpenStreetMap).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. A separate key that allows localhost, used only while running
# `next dev`. Keeps the production key locked to production domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY_DEV=

# Optional. Comma-separated mirror of the key's HTTP referrer list. When set,
# origins that are not listed never load the Google Maps script, so an
# unauthorized host cannot trigger RefererNotAllowedMapError in the console.
# Accepts full origins, bare hosts, wildcards and `*`:
#     https://app.example.com,http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_ALLOWED_ORIGINS=
